{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gearhead-definition.schema.json",
  "title": "Gearhead implementation-free definition",
  "description": "One entry per component family or page pattern. Must not contain markup, source, CSS, or Tailwind recipes. Provenance lives in manifest/coverage.json, never here.",
  "type": "object",
  "required": ["id", "name", "kind", "section", "version", "purpose", "parts", "variants", "states", "layout", "responsive", "tokenBindings", "constraints", "accessibility"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string" },
    "kind": { "enum": ["component", "pattern"] },
    "section": { "enum": ["actions-navigation", "forms-selection", "disclosure-feedback", "content-browsing", "page-patterns"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "purpose": { "type": "string" },
    "parts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "description"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "optional": { "type": "boolean" }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "values", "default", "description"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string" } },
          "default": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "states": { "type": "array", "items": { "type": "string" } },
    "layout": { "type": "array", "items": { "type": "string" } },
    "responsive": { "type": "array", "items": { "type": "string" } },
    "tokenBindings": {
      "type": "array", "minItems": 1,
      "description": "token is a name from tokens/tokens.json (no leading dashes). Values are resolved into the definitions-only bundle at build time.",
      "items": {
        "type": "object", "required": ["part", "role", "token"], "additionalProperties": false,
        "properties": {
          "part": { "type": "string" },
          "role": { "type": "string", "description": "Semantic role such as background, text, border, focus-ring, accent." },
          "token": { "type": "string" },
          "when": { "type": "string", "description": "Variant value or state that this binding applies to." }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "accessibility": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
